        "5230",
        "-d",
        "hero-viewer/standalone"
      ],
      "port": 5230
    },
    {
      "name": "hero-claude",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5231",
        "-d",
        "hero-viewer-claude/standalone"
      ],
      "port": 5231
    },
    {
      "name": "dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5240",
        "-d",
