      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5219",
        "--strictPort"
      ],
      "port": 5219
    },
    {
      "name": "hero-standalone",
      "runtimeExecutable": "python3",
